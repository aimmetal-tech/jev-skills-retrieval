{
  "name": "jev-skills-retrieval",
  "version": "0.1.0",
  "description": "Per-request skill retrieval with Jev for the Pi coding agent",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aimmetal-tech/jev-skills-retrieval.git"
  },
  "homepage": "https://github.com/aimmetal-tech/jev-skills-retrieval",
  "keywords": [
    "pi-package",
    "pi-extension",
    "skills",
    "jev",
    "retrieval"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs/configuration.md"
  ],
  "exports": {
    ".": "./dist/pi-adapter.js"
  },
  "pi": {
    "extensions": [
      "./dist/pi-adapter.js"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "tsx --test tests/*.test.ts",
    "eval": "tsx eval/run.ts",
    "benchmark": "tsx benchmark/run.ts",
    "benchmark:parallel": "tsx benchmark/parallel/pipeline.ts",
    "benchmark:prepare": "python benchmark/prepare.py",
    "benchmark:preflight": "tsx benchmark/run.ts --preflight",
    "benchmark:verify": "tsx benchmark/selftest.ts",
    "benchmark:check": "tsx benchmark/check.ts",
    "verify:package": "tsx scripts/verify-package.ts",
    "results:verify": "tsx scripts/publish-snapshot.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.7.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "undici": "8.10.2"
  }
}
